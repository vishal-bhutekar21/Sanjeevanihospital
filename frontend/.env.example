# ==============================================================================
# SANJEEVANI MULTISPECIALITY HOSPITAL — FRONTEND ENVIRONMENT
# ==============================================================================

# API address (Cloudflare Worker in worker/). Optional.
# Without it: on localhost the site uses http://localhost:8787/api (`npm run dev` in worker/),
# and the live site uses apiBaseUrl from src/config/hospital.ts.
# Set it to override, e.g. on Netlify. Must end with /api. Read at build time.
# VITE_API_URL="https://sanjeevani-api.<your-subdomain>.workers.dev/api"

# Razorpay Client Public Key
# Not needed: the key ID is sent by the API with each payment order
# VITE_RAZORPAY_KEY_ID=""

# Optional Google Maps Embed API Key for interactive live directions
VITE_GOOGLE_MAPS_KEY=""

# Optional Firebase Client SDK (for Analytics / Web Push)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
