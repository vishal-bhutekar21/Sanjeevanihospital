# ==============================================================================
# SANJEEVANI MULTISPECIALITY HOSPITAL — BACKEND CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# PostgreSQL / Supabase Database Connection
# Direct Connection (for migrations):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for schema push (no pgbouncer):
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Security Secrets (Minimum 64-char random high-entropy strings)
JWT_SECRET="sanjeevani_multispeciality_production_jwt_secret_key_2026_super_secure_entropy_key"
JWT_EXPIRES_IN="7d"

# Razorpay (Dashboard → Account & Settings → API Keys).
# Leave empty to switch online payment off; patients then pay at the OPD counter.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# MSG91 OTP (Dashboard → OTP → Templates; needs a DLT-approved template).
# Required in production: without it the booking page asks patients to call reception.
# In development (NODE_ENV not "production") the OTP is 123456 and is printed in the server log.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Firebase Admin SDK Configuration (for Push Notifications / FCM)
# FIREBASE_PROJECT_ID="sanjeevani-hospital-jalna"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@sanjeevani-hospital-jalna.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Hospital Tenant Metadata
HOSPITAL_TENANT_ID="hosp-sanjeevani-jalna"
HOSPITAL_NAME="Sanjeevani Multispeciality Hospital"
HOSPITAL_CITY="Jalna"
HOSPITAL_STATE="Maharashtra"
